{
  // Type-checks design.mjs against the packages it imports, without JSDoc noise: implicit any allowed.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "types": ["node"]
  },
  "include": ["design.mjs"]
}
