{
  "name": "@imgly/demo-quickstart-mastra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A CoDesign SDK starter kit: a design agent on Mastra turns a brief into a PNG and an editable design, with the executor in Docker on your machine.",
  "scripts": {
    "start": "node --env-file=.env design.mjs",
    "executor": "docker run -d --name codesign-executor --restart always -p 127.0.0.1:8080:8080 --env-file .env --tmpfs /var/lib/codesign-executor:uid=1000 imgly/codesign-executor:1.83.0",
    "executor:stop": "docker rm -f codesign-executor",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@imgly/codesign-sdk": "1.83.0",
    "@mastra/core": "1.75.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "5.9.3"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22"
  }
}
