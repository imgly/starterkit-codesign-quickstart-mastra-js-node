# Copy to .env (gitignored). `npm run executor` passes it to the executor, and `npm start` to design.mjs.

# Your CoDesign license key. The executor uses it for the engine and the exports, design.mjs for the model.
# Contact sales (https://img.ly/forms/contact-sales/) to get a CoDesign license key.
IMGLY_CESDK_LICENSE=

# The token the executor and design.mjs share. It works as it is.
EXECUTOR_TOKEN=codesign-quickstart-token

# Optional: the gateway's model id (default @openrouter/anthropic/claude-opus-5). Any model OpenRouter serves works as
# @openrouter/ and its OpenRouter id. The gateway lists its own ids with your key:
#   curl -H "Authorization: Bearer $IMGLY_CESDK_LICENSE" https://gateway.img.ly/v1/models
# MODEL=@openrouter/google/gemini-3.8-flash

# Optional: the executor's address (default http://localhost:8080).
# EXECUTOR_URL=http://localhost:8080
